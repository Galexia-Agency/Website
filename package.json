{
  "name": "galexia",
  "version": "1.0.0",
  "description": "We are a creative agency specialising in website design and development. We’re a fairly new company built from the ground up to help you grow. We use the latest and greatest practises and technologies so that we can pass on these benefits to you.",
  "author": "Galexia Creative Agency Ltd",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "pnpm run generate",
    "deploy": "pnpm run build && wrangler deploy",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "cms:dev": "pnpm --dir cms run dev",
    "cms:build": "pnpm --dir cms run build",
    "test:forms": "node --test --test-isolation=none worker/test/*.test.ts",
    "typecheck": "nuxt typecheck && tsc -p worker/tsconfig.json",
    "lint:scripts": "eslint .",
    "fix:scripts": "eslint . --fix",
    "lint:styles": "stylelint \"**/*.{vue,scss}\"",
    "fix:styles": "stylelint \"**/*.{vue,scss}\" --fix"
  },
  "dependencies": {
    "@fontsource/assistant": "^5.2.8",
    "@fontsource/montserrat": "^5.2.8",
    "@fontsource/open-sans": "^5.2.7",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@joebailey26/nuxt-static-wordpress": "^0.1.1",
    "@joebailey26/turnstile-forms": "^0.1.1",
    "nuxt": "^4.6.4",
    "nuxt-component-date": "git+https://github.com/Galexia-Agency/nuxt-component-date.git#0b7351eee27645e0a4a64172e46d40b3b87b6a61",
    "nuxt-component-pagination": "git+https://github.com/Galexia-Agency/nuxt-component-pagination.git#dd4d0bea6b2853a977b5a97528c0b286a40534ba",
    "sass": "^1.108.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-galexia": "npm:@galexia-agency/eslint-config-galexia@3.3.0",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^15.11.0",
    "stylelint-config-galexia": "git+https://github.com/Galexia-Agency/stylelint-config.git#861ee9c7f547f05547658dd78de8519e80c9a23f",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "4.156.0"
  },
  "browserslist": [
    "last 5 versions and not ie <= 11 and > 0.2% and not dead and not op_mini all"
  ],
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^10.11.1"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "workerd"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "core-js-pure",
      "nuxt"
    ]
  }
}
